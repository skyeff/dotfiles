(defun juntar-com (itens)
  "ITENS: lista de (TEXTO . ESPAÇO-ANTES). Salta vazios; o 1.º não leva espaço."
  (with-output-to-string (o)
    (let ((primeiro t))
      (dolist (i itens)
        (unless (string= (car i) "")
          (unless primeiro (write-string (cdr i) o))
          (write-string (car i) o)
          (setf primeiro nil))))))

(add-screen-mode-line-formatter
 #\Z (lambda (ml)
       (declare (ignore ml))
       (juntar-com
        (list (cons (seg-swank) "")
              (cons *estado-rede* *cfg-espaco-seg*)
              (cons *estado-bateria* *cfg-espaco-seg*)
              (cons (handler-case (fmt-hora) (error () ""))
                    *cfg-espaco-hora*)))))

