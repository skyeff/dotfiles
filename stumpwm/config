;;;; =====================================================================
;;;; 6. GRUPOS (idempotente: reavaliar o rc não duplica)
;;;; =====================================================================

(rc-try "grupos"
  (destructuring-bind (base extra flut) *cfg-grupos*
    (let ((scr (current-screen)))
      (unless (find-group scr base)  (grename base))
      (unless (find-group scr extra) (gnewbg extra))
      (unless (find-group scr flut)  (gnewbg-float flut)))))

;;;; =====================================================================
;;;; 7. SWANK — REPL do StumpWM a partir do Emacs (SLIME)
;;;; =====================================================================
;;; Carregado sob demanda (primeiro C-z C-e), para não custar tempo no arranque.
;;; Requer Quicklisp: (ql:quickload :swank).

(defvar *port-number* *cfg-swank-porta* "Porta do Swank")
(defvar *swank-server-p* nil "Swank activo?")

(defcommand start-swank () ()
  "Start Swank if it is not already running"
  (if *swank-server-p*
      (message "Swank server is already active on Port^5 ~a^n" *port-number*)
      (rc-try "start-swank"
        (unless (find-package "SWANK") (ql-carregar "swank"))
        (funcall (sym "SWANK" "CREATE-SERVER")
                 :port *port-number*
                 :style (symbol-value (sym "SWANK" "*COMMUNICATION-STYLE*"))
                 :dont-close t)
        (setf *swank-server-p* t)
        (message "Swank server is now active on Port^5 ~a^n.
Use^4 M-x slime-connect^n in Emacs.
Type^2 (in-package :stumpwm)^n in Slime REPL." *port-number*))))

(defcommand stop-swank () ()
  "Stop Swank"
  (rc-try "stop-swank"
    (funcall (sym "SWANK" "STOP-SERVER") *port-number*)
    (setf *swank-server-p* nil)
    (message "Stopping Swank Server! Closing Port^5 ~a^n." *port-number*)))

(defcommand toggle-swank () ()
  (if *swank-server-p*
      (run-commands "stop-swank")
      (run-commands "start-swank")))


(defun seg-swank ()
  (if *swank-server-p*
      (format nil "^2~a^n~a~a" (icone #xF00C "Swank") *cfg-espaco-icone* *port-number*)
      ""))

