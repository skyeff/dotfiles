;;;; =====================================================================
;;;; 1. INFRAESTRUTURA — registo de erros e ligação tardia
;;;; =====================================================================

(defvar *rc-log* (merge-pathnames ".stumpwm-rc.log" (user-homedir-pathname)))

(defun rc-log (fmt &rest args)
  (with-open-file (s *rc-log* :direction :output
                              :if-exists :append :if-does-not-exist :create)
    (apply #'format s fmt args)
    (terpri s)))

(defvar *rc-erros* 0 "Nº de erros registados neste arranque")

(defmacro rc-try (label &body body)
  "Avalia BODY; um erro de avaliação vira linha de registo, não aborto.
Devolve o valor de BODY, ou NIL se houve erro."
  `(handler-case (progn ,@body)
     (error (c) (incf *rc-erros*) (rc-log "~A: ~A" ,label c) nil)))

(rc-log "=== arranque ===")

(defun sym (pacote nome)
  "Símbolo NOME de PACOTE, ou NIL. Evita `pacote:símbolo` para pacotes
que só existem depois de um load (o leitor falharia antes do rc-try)."
  (let ((p (find-package pacote)))
    (and p (values (find-symbol nome p)))))

