(defun ql-carregar (sistema)
  (let ((f (sym "QUICKLISP-CLIENT" "QUICKLOAD")))
    (if f (funcall f sistema :silent t) (error "Quicklisp ausente"))))

(rc-try "module-dir" (set-module-dir "/usr/share/stumpwm/contrib/"))

(dolist (m '("swm-gaps" "swm-emacs" "app-menu"))
  (rc-try (format nil "load-module ~A" m) (load-module m)))

;; Fonte TTF. *ttf-ok* decide se a barra usa glifos Nerd Font.
(defvar *ttf-ok* nil)

(rc-try "ttf-fonts"
  (ql-carregar "clx-truetype")
  (load-module "ttf-fonts")
  (funcall (sym "XFT" "CACHE-FONTS"))
  (flet ((fonte (tam)
           (make-instance (sym "XFT" "FONT")
                          :family *cfg-fonte-familia*
                          :subfamily *cfg-fonte-estilo*
                          :size tam)))
    (set-font (list (fonte *cfg-fonte-tamanho*)    ; ^f0 texto
                    (fonte *cfg-fonte-icones*))))  ; ^f1 ícones
  (setf *ttf-ok* t))

(unless *ttf-ok*
  (rc-try "fonte-core" (set-font *cfg-fonte-core*)))

(defun icone (codigo &optional (texto ""))
  "Glifo Nerd Font CODIGO na fonte de ícones; sem TTF, devolve TEXTO."
  (if *ttf-ok* (format nil "^f1~c^f0" (code-char codigo)) texto))

