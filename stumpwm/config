;;; Estado do sistema: leitura directa de /sys e /proc (sem processos)
(defvar *estado-bateria* "")
(defvar *estado-cpu* "")
(defvar *estado-ram* "")
(defvar *estado-rede* "")
(defvar *cpu-anterior* nil "(total . ocioso) da leitura anterior")

(defun ler-linha (caminho)
  (with-open-file (s caminho :if-does-not-exist nil)
    (and s (read-line s nil nil))))

(defun palavras (str)
  "Separa STR em palavras por espaços/tabs."
  (let ((out '()) (ini nil))
    (loop for i from 0 to (length str)
          for c = (and (< i (length str)) (char str i))
          do (if (and c (not (member c '(#\Space #\Tab))))
                 (unless ini (setf ini i))
                 (when ini (push (subseq str ini i) out) (setf ini nil))))
    (nreverse out)))

(defun fmt-bateria ()
  (let* ((dir (format nil "/sys/class/power_supply/~a/" *cfg-bateria*))
         (cap (parse-integer (or (ler-linha (concatenate 'string dir "capacity")) "")
                             :junk-allowed t))
         (st (or (ler-linha (concatenate 'string dir "status")) "")))
    (if (null cap)
        ""
        (let* ((carregando (string= st "Charging"))
               (ligada (or carregando (string= st "Full") (string= st "Not charging")))
               (glifo (cond ((>= cap 88) #xF240) ((>= cap 63) #xF241)
                            ((>= cap 38) #xF242) ((>= cap 13) #xF243)
                            (t #xF244)))
               (cor (cond (carregando "^3") ((<= cap 15) "^2") (t "^4"))))
          (format nil "~a~a~a^n ~d% "
                  cor
                  (cond (carregando (concatenate 'string (icone #xF0E7 "") " "))
                        (ligada (concatenate 'string (icone #xF1E6 "") " "))
                        (t ""))
                  (icone glifo "BAT ")
                  cap)))))

(defun fmt-cpu ()
  (let* ((n (mapcar (lambda (x) (or (parse-integer x :junk-allowed t) 0))
                    (cdr (palavras (or (ler-linha "/proc/stat") "")))))
         (n (subseq n 0 (min 8 (length n)))))
    (if (< (length n) 5)
        ""
        (let* ((total (reduce #'+ n))
               (ocioso (+ (nth 3 n) (nth 4 n)))
               (ant *cpu-anterior*)
               (pct (if ant
                        (let ((dt (- total (car ant))) (di (- ocioso (cdr ant))))
                          (if (plusp dt) (round (* 100 (- dt di)) dt) 0))
                        0)))
          (setf *cpu-anterior* (cons total ocioso))
          (format nil "^6~a^n ~d% " (icone #xF2DB "CPU ") pct)))))

(defun meminfo-kb (chave)
  (with-open-file (s "/proc/meminfo" :if-does-not-exist nil)
    (when s
      (loop for l = (read-line s nil nil)
            while l
            when (and (> (length l) (length chave))
                      (string= chave l :end2 (length chave)))
              return (parse-integer (second (palavras l)) :junk-allowed t)))))

(defun fmt-ram ()
  (let ((tot (meminfo-kb "MemTotal:")) (disp (meminfo-kb "MemAvailable:")))
    (if (and tot disp (plusp tot))
        (format nil "^7~a^n ~d% " (icone #xF233 "RAM ")
                (round (* 100 (- tot disp)) tot))
        "")))

(defun fmt-rede ()
  "Qualidade do Wi-Fi (aproximação: /proc/net/wireless, escala 0-70)."
  (with-open-file (s "/proc/net/wireless" :if-does-not-exist nil)
    (if (null s)
        ""
        (progn
          (read-line s nil nil) (read-line s nil nil)
          (let ((l (read-line s nil nil)))
            (if (null l)
                ""
                (let ((q (parse-integer (or (third (palavras l)) "")
                                        :junk-allowed t)))
                  (if (and q (plusp q))
                      (format nil "^3~a^n ~d% " (icone #xF1EB "WiFi ")
                              (min 100 (round (* q 100) 70)))
                      (format nil "^2~a^n " (icone #xF1EB "WiFi ")))))))))) 

(defun atualizar-estado ()
  (flet ((seguro (f) (handler-case (funcall f) (error () ""))))
    (setf *estado-bateria* (seguro #'fmt-bateria)
          *estado-cpu*     (seguro #'fmt-cpu)
          *estado-ram*     (seguro #'fmt-ram)
          *estado-rede*    (seguro #'fmt-rede))))

(defvar *timer-estado* nil)
(when *timer-estado* (ignore-errors (cancel-timer *timer-estado*)))
(setf *timer-estado*
      (run-with-timer 0 *cfg-intervalo-estado* #'atualizar-estado))

(add-screen-mode-line-formatter #\B (lambda (ml) (declare (ignore ml)) *estado-bateria*))
