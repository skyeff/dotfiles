;;; -*- mode: lisp; -*-
;;; config — StumpWM (Arch, dois monitores, Hack Nerd Font): ARRANQUE
;;; Este é o ficheiro principal: ~/.config/stumpwm/config
;;;
;;; Os restantes ficam na mesma pasta e são lidos daqui, por esta ordem:
;;;   config          arranque: registo de erros, módulos, grupos, swank, overrides
;;;   vars.lisp       as variáveis que se ajustam (cores, barra, gaps, passos...)
;;;   interface.lisp  o que se vê: fonte, cores, barra, lançador, avisos
;;;   teclas.lisp     atalhos e os comandos que eles chamam
;;;
;;; Base: stumpwm-demo-config de James McCabe (GPLv3,
;;; https://github.com/jamesmccabe/stumpwm-demo-config). Alterações: nomes
;;; dos grupos, painel de parâmetros, secções, barra só no monitor 1080p,
;;; ícones Nerd Font, estado lido directamente de /sys e /var, teclas do
;;; hyprland.conf com Super substituído pelo prefixo C-z.
;;;
;;; NÃO TESTADO num StumpWM real. Erros de arranque vão para
;;; ~/.stumpwm-rc.log em vez de abortarem o ficheiro: lê-o sempre.
;;; Os overrides do exemplo estão na última secção deste ficheiro.

(in-package :stumpwm)

;;;; =====================================================================
;;;; 1. INFRAESTRUTURA — registo de erros, ligação tardia, outros ficheiros
;;;; =====================================================================

(defvar *rc-log* (merge-pathnames ".stumpwm-rc.log" (user-homedir-pathname)))

(defun rc-log (fmt &rest args)
  (with-open-file (s *rc-log* :direction :output
                              :if-exists :append :if-does-not-exist :create)
    (apply #'format s fmt args)
    (terpri s)))

(defvar *rc-erros* 0 "Nº de erros registados neste arranque")

(defmacro rc-try (label &body body)
  "Avalia BODY; um erro de avaliação vira linha de registo, não aborto.
Devolve o valor de BODY, ou NIL se houve erro."
  `(handler-case (progn ,@body)
     (error (c) (incf *rc-erros*) (rc-log "~A: ~A" ,label c) nil)))

(rc-log "=== arranque ===")

(defun sym (pacote nome)
  "Símbolo NOME de PACOTE, ou NIL. Evita `pacote:símbolo` para pacotes
que só existem depois de um load (o leitor falharia antes do rc-try)."
  (let ((p (find-package pacote)))
    (and p (values (find-symbol nome p)))))

(defun saida (cmd)
  "Corre CMD no shell e devolve a saída sem espaços nas pontas (\"\" se falhar)."
  (string-trim '(#\Space #\Newline #\Tab)
               (or (ignore-errors (run-shell-command cmd t)) "")))

(defparameter *rc-dir*
  (let ((p (or *load-truename* *compile-file-truename*)))
    (if p
        (make-pathname :name nil :type nil :version nil :defaults p)
        (merge-pathnames ".config/stumpwm/" (user-homedir-pathname))))
  "Pasta deste rc; os outros ficheiros são lidos a partir dela.")

(defun rc-load (nome)
  "Carrega NOME (relativo a *rc-dir*). Devolve T; um erro vira linha de registo."
  (rc-try (format nil "load ~A" nome)
    (load (merge-pathnames nome *rc-dir*))
    t))

;; Sem vars.lisp nada do resto faz sentido: pára aqui, com a causa à vista.
(unless (rc-load "vars.lisp")
  (error "vars.lisp falhou: ver ~~/.stumpwm-rc.log"))

;;;; =====================================================================
;;;; 2. BÁSICO — shell, prefixo, fundo, wallpaper, módulos
;;;; =====================================================================

;; run-shell-command compõe sintaxe POSIX; o teu shell é Elvish.
(setf *shell-program* "/bin/sh")

(set-prefix-key (kbd *cfg-prefixo*))

(run-shell-command
 (format nil "xsetroot -solid '~a' -cursor_name left_ptr" *cfg-cor-fundo*))
(run-shell-command (format nil "feh --bg-fill ~a" *cfg-wallpaper*))


;; Quicklisp (só necessário para ttf-fonts e swank)
(rc-try "quicklisp"
  (let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
    (when (probe-file setup) (load setup))))

(defun ql-carregar (sistema)
  (let ((f (sym "QUICKLISP-CLIENT" "QUICKLOAD")))
    (if f (funcall f sistema :silent t) (error "Quicklisp ausente"))))

(rc-try "module-dir" (set-module-dir "/usr/share/stumpwm/contrib/"))

(dolist (m '("swm-gaps" "swm-emacs"))
  (rc-try (format nil "load-module ~A" m) (load-module m)))

;;; Aparência (fonte, cores, barra, lançador, avisos): interface.lisp
(rc-load "interface.lisp")

;;;; =====================================================================
;;;; 3. GRUPOS (idempotente: reavaliar o rc não duplica)
;;;; =====================================================================

(rc-try "grupos"
  (destructuring-bind (base extra flut) *cfg-grupos*
    (let ((scr (current-screen)))
      (unless (find-group scr base)  (grename base))
      (unless (find-group scr extra) (gnewbg extra))
      (unless (find-group scr flut)  (gnewbg-float flut)))))

;;;; =====================================================================
;;;; 4. SWANK — REPL do StumpWM a partir do Emacs (SLIME)
;;;; =====================================================================
;;; Carregado sob demanda (primeiro C-z C-e), para não custar tempo no arranque.
;;; Requer Quicklisp: (ql:quickload :swank).

(defvar *port-number* *cfg-swank-porta* "Porta do Swank")
(defvar *swank-server-p* nil "Swank activo?")

(defcommand start-swank () ()
  "Start Swank if it is not already running"
  (if *swank-server-p*
      (message "Swank server is already active on Port^5 ~a^n" *port-number*)
      (rc-try "start-swank"
        (unless (find-package "SWANK") (ql-carregar "swank"))
        (funcall (sym "SWANK" "CREATE-SERVER")
                 :port *port-number*
                 :style (symbol-value (sym "SWANK" "*COMMUNICATION-STYLE*"))
                 :dont-close t)
        (setf *swank-server-p* t)
        (message "Swank server is now active on Port^5 ~a^n.
Use^4 M-x slime-connect^n in Emacs.
Type^2 (in-package :stumpwm)^n in Slime REPL." *port-number*))))

(defcommand stop-swank () ()
  "Stop Swank"
  (rc-try "stop-swank"
    (funcall (sym "SWANK" "STOP-SERVER") *port-number*)
    (setf *swank-server-p* nil)
    (message "Stopping Swank Server! Closing Port^5 ~a^n." *port-number*)))

(defcommand toggle-swank () ()
  (if *swank-server-p*
      (run-commands "stop-swank")
      (run-commands "start-swank")))


(defun seg-swank ()
  (if *swank-server-p*
      (format nil "^2~a^n~a~a" (icone #xF00C "Swank") *cfg-espaco-icone* *port-number*)
      ""))

;;;; =====================================================================
;;;; 5. OVERRIDES (do exemplo; cada bloco isolado)
;;;; =====================================================================

;; Cores normais sem escurecimento
(rc-try "override-cores"
  (when (and (fboundp 'lookup-color) (fboundp 'adjust-color)
             (fboundp 'alloc-color))
    (defun update-color-map (screen)
      "Read *colors* and cache their pixel colors for use when rendering colored text."
      (labels ((map-colors (amt)
                 (loop for c in *colors*
                       as color = (lookup-color screen c)
                       do (adjust-color color amt)
                       collect (alloc-color screen color))))
        (setf (screen-color-map-normal screen)
              (apply #'vector (map-colors 0.00)))))
    (update-color-map (current-screen))))

;; Mensagem de saída com cores
(rc-try "override-quit"
  (defcommand quit-confirm () ()
    "Prompt the user to confirm quitting StumpWM."
    (if (y-or-n-p (format nil "~@{~a~^~%~}"
                          "You are about to quit the window manager to TTY."
                          "Really ^2quit^n StumpWM?"
                          "Confirm? "))
        (quit)
        (xlib:unmap-window (screen-message-window (current-screen))))))

;; Splits invertidos: vsplit = lado a lado, hsplit = um sobre o outro (C-z 3 / C-z 2)
(rc-try "override-splits"
  (defcommand (vsplit tile-group) (&optional (ratio "1/2")) (:string)
    "Split the current frame into 2 side-by-side frames."
    (split-frame-in-dir (current-group) :column (read-from-string ratio)))

  (defcommand (hsplit tile-group) (&optional (ratio "1/2")) (:string)
    "Split the current frame into 2 frames, one on top of the other."
    (split-frame-in-dir (current-group) :row (read-from-string ratio)))

  (defcommand (vsplit-equally tile-group) (amt)
    ((:number "Enter the number of frames: "))
    "Split current frame in n columns of equal size."
    (split-frame-eql-parts (current-group) :column amt))

  (defcommand (hsplit-equally tile-group) (amt)
    ((:number "Enter the number of frames: "))
    "Split current frame in n rows of equal size."
    (split-frame-eql-parts (current-group) :row amt)))

;;; Atalhos e comandos: teclas.lisp
(rc-load "teclas.lisp")

(rc-log "rc concluído: ~d erro(s); ttf=~a" *rc-erros* *ttf-ok*)
(when (plusp *rc-erros*)
  (rc-try "aviso"
    (message "^2rc: ~d erro(s)^n — ver ~~/.stumpwm-rc.log" *rc-erros*)))
;;; config ends here
